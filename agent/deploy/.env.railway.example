# Railway deployment env template for the Clinical Co-Pilot agent service.
#
# NEVER commit real secrets. Set these on the Railway service instead:
#   railway variables --set KEY=value        (or the Railway dashboard → Variables)
# This file documents WHICH variables the service reads and whether each is
# required or optional. Names/casing match src/copilot/config.py (Settings).
#
# NOTE: PORT is injected by Railway automatically — do NOT set it. The container
# binds to $PORT (falling back to 8000 locally). See deploy/RUNBOOK.md.

# --- Anthropic (REQUIRED — the agent cannot synthesize without a real key) ---
ANTHROPIC_API_KEY=sk-ant-your-real-key
ANTHROPIC_MODEL=claude-sonnet-5            # optional; defaults to claude-sonnet-5

# --- OpenEMR (REQUIRED — point at a reachable OpenEMR the agent can auth to) ---
# AUTH BOUNDARY: the agent authenticates via the OAuth2 *password grant*, which
# is a DEV setting (oauth_password_grant). The public Railway OpenEMR production
# image does NOT enable it by default. A deployed agent therefore needs an
# OpenEMR that either (a) has the password grant enabled, or (b) the SMART
# EHR-launch auth-code flow (not built in M0-M2). See RUNBOOK "Auth boundary".
OPENEMR_BASE_URL=https://your-openemr.example.com
OPENEMR_FHIR_BASE=https://your-openemr.example.com/apis/default/fhir
OPENEMR_OAUTH_BASE=https://your-openemr.example.com/oauth2/default
OPENEMR_DEV_USER=admin                     # user for the password grant
OPENEMR_DEV_PASS=change-me                 # REQUIRED with password grant; keep secret
OPENEMR_CLIENT_ID=                         # filled after dynamic client registration
OPENEMR_CLIENT_SECRET=                     # keep secret

# --- Langfuse (OPTIONAL — observability; absent keys => tracing disabled) ---
# Leaving these as placeholders/empty degrades gracefully and never gates /ready.
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Agent (OPTIONAL) ---
LOG_LEVEL=INFO
# AGENT_PORT is unused on Railway; the platform-injected PORT wins.
