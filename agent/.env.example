# Copy to .env and fill in.  .env is git-ignored — never commit real keys.

# --- Anthropic (required for M1+ and local testing) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5           # opus for hard cases

# --- OpenEMR (local development-easy stack) ---
OPENEMR_BASE_URL=http://localhost:8300
OPENEMR_FHIR_BASE=http://localhost:8300/apis/default/fhir
OPENEMR_OAUTH_BASE=http://localhost:8300/oauth2/default
# Dev auth: development-easy enables the OAuth2 password grant, so the agent can
# obtain a real user-bound token with these dev credentials (no SMART launch UI
# needed just to validate the foundation). Client is registered at startup.
OPENEMR_DEV_USER=admin
OPENEMR_DEV_PASS=pass
OPENEMR_CLIENT_ID=                        # filled after dynamic registration
OPENEMR_CLIENT_SECRET=

# --- Langfuse (PHI-scrubbed observability) ---
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com  # or your self-hosted URL

# --- Agent ---
AGENT_PORT=8000
LOG_LEVEL=INFO
